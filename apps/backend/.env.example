# === TAIFA Payment Service — environment ===
# Copy to `.env` and fill in. Never commit real secrets.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Comma-separated. In production (DEBUG=false) this must be set explicitly.
DJANGO_ALLOWED_HOSTS=*
DJANGO_LOG_LEVEL=INFO

# Postgres (production). Omit to use the SQLite dev/test fallback.
# DATABASE_URL=postgres://taifa:taifa@localhost:5432/taifa_payments

# === Security / CORS (production) ===
# When DEBUG=false, lock these down. CORS_ALLOW_ALL defaults to DEBUG.
# CORS_ALLOW_ALL=false
# CORS_ALLOWED_ORIGINS=https://app.taifa.co.tz
# CSRF_TRUSTED_ORIGINS=https://app.taifa.co.tz
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# === Rate limits (DRF throttling) ===
# THROTTLE_ANON=120/min
# THROTTLE_DEVICE_REGISTER=20/min
# THROTTLE_MONEY_WRITE=60/min

# === Error tracking / APM (optional; activates only when set) ===
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Celery / Redis (async webhook + retry processing)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=true

# Shared throttle/session cache (required when DEBUG=false)
# CACHE_URL=redis://localhost:6379/2

# Stub AI/identity/gov adapters — must be false in production
# TAIFA_ALLOW_STUB_ADAPTERS=false

# Outbox webhook fan-out (JSON list of {"url","secret"} or bare URLs)
# TAIFA_OUTBOX_WEBHOOK_URLS_JSON=[]
# TAIFA_OUTBOX_WEBHOOK_SECRET=

# === M-Pesa Daraja ===
# Copy to `.env` and fill CONSUMER_KEY / CONSUMER_SECRET from the Daraja portal.
# Never commit real secrets. Sandbox Lipa Na M-Pesa Online defaults:
#   SHORTCODE=174379 + Safaricom-published sandbox passkey (auto-filled when
#   MPESA_ENVIRONMENT=sandbox and MPESA_PASSKEY is empty).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Public HTTPS base for STK callbacks (ngrok/cloudflare). Example:
#   ngrok http 8000
#   MPESA_CALLBACK_BASE_URL=https://<subdomain>.ngrok-free.dev
# Until set, settle via POST /api/v1/payments/topups/{id}/poll-status after PIN.
MPESA_CALLBACK_BASE_URL=https://your-public-host
MPESA_TIMEOUT_SECONDS=30
# Webhook trust. Production (DJANGO_DEBUG=false) REQUIRES shared secret
# (system check payments.E004). Prefer HMAC + IP allow-list as well.
# Headers: X-TAIFA-Mpesa-Webhook-Secret and/or
#   X-TAIFA-Webhook-Timestamp + X-TAIFA-Webhook-Signature (HMAC-SHA256 hex).
# MPESA_WEBHOOK_ALLOWED_IPS=196.201.214.0/24,196.201.220.0/24
# MPESA_WEBHOOK_SHARED_SECRET=
# MPESA_WEBHOOK_REQUIRE_HMAC=true
# MPESA_WEBHOOK_FAIL_CLOSED=true
# MPESA_WEBHOOK_MAX_SKEW_SECONDS=300

# Prometheus scrape allow-list (optional; empty = open on private networks).
# METRICS_ALLOWED_IPS=10.0.0.0/8

# Ops / observability
# TAIFA_ENVIRONMENT=production
# TAIFA_LOG_JSON=true
# OTEL_SERVICE_NAME=taifa-payments
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SDK_DISABLED=false
# BACKUP_ENCRYPTION_KEY=
# GRAFANA_ADMIN_PASSWORD=
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=
# SMS_GATEWAY_WEBHOOK_URL=
# GUNICORN_WORKERS=3
# CELERY_CONCURRENCY=4

# Mobility real-time tracking (Redis Channels). Use a dedicated Redis DB/cluster
# at national scale and never expose it publicly.
# CHANNEL_REDIS_URL=redis://redis:6379/1
# CHANNEL_CAPACITY=1500
# CHANNEL_EXPIRY_SECONDS=60

# National Mobility Registry — mandatory in production. JSON values are
# base64-encoded AES keys. Retain old versions while encrypted records use them.
# MOBILITY_DOCUMENT_KEYS_JSON={"2026-v1":"<base64-32-byte-key>"}
# MOBILITY_ACTIVE_DOCUMENT_KEY_VERSION=2026-v1
# MOBILITY_PII_INDEX_KEY=<minimum-32-character-HMAC-secret>
# MOBILITY_VERIFICATION_ADAPTERS_JSON={"nida":"package.module.NidaAdapter"}
# MOBILITY_DOCUMENT_SCANNER=package.module.ClamAvDocumentScanner

# Withdrawals: when true, POST /withdrawals auto-approves + pays out (dev/sandbox).
# Production: MUST be false (payments.E003).
# TAIFA_WITHDRAWAL_AUTO_APPROVE=false

# Risk Engine — production defaults are FINITE when DEBUG=false.
# 0 = unlimited; in production that requires RISK_ALLOW_UNLIMITED=true (approved).
# RISK_ALLOW_UNLIMITED=false
# RISK_PER_TXN_LIMIT_MINOR=500000000
# RISK_DAILY_DEBIT_LIMIT_MINOR=2000000000
# RISK_DAILY_CREDIT_LIMIT_MINOR=5000000000
# RISK_REVIEW_ABOVE_MINOR=100000000
# RISK_VELOCITY_WINDOW_SECONDS=60
# RISK_VELOCITY_MAX_TXNS=30
# RISK_SANCTIONS_OWNERS=

# Demo paths — default to DJANGO_DEBUG. MUST be false in production (E001/E002).
# TAIFA_ALLOW_DEMO_STK=false
# TAIFA_ALLOW_DEMO_WALLET_FUNDING=false

# See docs/PRODUCTION_GATE.md before enabling real customer funds.
